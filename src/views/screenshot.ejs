<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=750">
<title>高管周总结 · 推送图</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body {
  font-family: 'Inter', 'Noto Sans SC', system-ui, sans-serif;
  background: #ffffff; color: #0d253d; font-weight: 300; line-height: 1.6;
  width: 750px;
  font-feature-settings: "ss01";
}
.zone { padding:32px 28px; }
.zone-summary { background:#f6f9fc; }
.zone-decisions { background:#fff; }
.zone-overview { background:linear-gradient(180deg,#f6f9fc 0%,#fff 100%); }
.zone-warning { background:#f6f9fc; }

.section-header { display:flex; align-items:center; gap:10px; margin-bottom:18px; }
.section-icon { font-size:16px; }
.section-title { font-size:20px; font-weight:300; letter-spacing:-0.4px; color:#0d253d; }
.section-sub { font-size:13px; color:#64748d; margin-left:auto; }

.card { background:#fff; border-radius:14px; padding:22px 24px; border:1px solid #e3e8ee; }

.summary-item { display:flex; gap:12px; padding:10px 0; }
.summary-item+.summary-item { border-top:1px solid #e3e8ee; }
.summary-dot { width:10px; height:10px; border-radius:50%; margin-top:7px; flex-shrink:0; }
.summary-dot.green { background:#10b981; } .summary-dot.yellow { background:#f59e0b; } .summary-dot.red { background:#ef4444; }
.summary-text { font-size:15px; font-weight:300; line-height:1.7; color:#273951; }
.summary-text strong { font-weight:400; color:#0d253d; }

.decision-item { display:flex; gap:14px; padding:12px 0; }
.decision-item+.decision-item { border-top:1px solid #e3e8ee; }
.decision-tag { width:28px; height:28px; border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; }
.decision-tag.action { background:#fef2f2; } .decision-tag.decision { background:#fffbeb; }
.decision-body { flex:1; }
.decision-title { font-size:15px; font-weight:400; margin-bottom:3px; color:#0d253d; }
.decision-desc { font-size:14px; font-weight:300; color:#64748d; line-height:1.6; }
.decision-meta { display:flex; gap:8px; margin-top:5px; }
.decision-source { font-size:11px; padding:2px 8px; border-radius:9999px; background:#f6f9fc; color:#64748d; }

.sub-section-title { font-size:13px; font-weight:400; color:#64748d; margin-bottom:12px; letter-spacing:0.1px; }
.health-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:16px; }
.health-item { background:#f6f9fc; border-radius:10px; padding:14px 16px; }
.health-item .label { font-size:12px; color:#64748d; margin-bottom:4px; }
.health-item .value { font-size:15px; font-weight:400; display:flex; align-items:center; gap:8px; }
.dot { width:8px; height:8px; border-radius:50%; display:inline-block; }
.dot.green { background:#10b981; } .dot.yellow { background:#f59e0b; } .dot.red { background:#ef4444; }
.event-item { display:flex; gap:10px; padding:10px 0; }
.event-item+.event-item { border-top:1px solid #e3e8ee; }
.event-icon { font-size:14px; flex-shrink:0; margin-top:3px; }
.event-body { font-size:14px; font-weight:300; color:#64748d; line-height:1.6; }
.event-body strong { font-weight:400; color:#0d253d; }

.warn-item { padding:12px 0; }
.warn-item+.warn-item { border-top:1px solid #e3e8ee; }
.warn-title { font-size:15px; font-weight:400; margin-bottom:3px; display:flex; align-items:center; gap:6px; }
.warn-desc { font-size:14px; font-weight:300; color:#64748d; line-height:1.6; }
.warn-prep { font-size:12px; color:#f59e0b; margin-top:4px; }

.hl-num { font-weight:500; color:#0d253d; }

.bottom-bar { background:#0d253d; color:#fff; text-align:center; padding:20px 28px; font-size:14px; font-weight:300; letter-spacing:0.5px; }
</style>
</head>
<body>

<div style="background:#fff;padding:20px 28px 0;display:flex;align-items:center;justify-content:space-between;">
  <div style="font-size:22px;font-weight:300;letter-spacing:-0.4px;">高管周总结</div>
  <div style="font-size:14px;color:#64748d;"><%= report.weekInfo.startDate %> — <%= report.weekInfo.endDate %></div>
</div>

<div class="zone zone-summary">
  <div class="section-header">
    <span class="section-icon">🧠</span>
    <span class="section-title">本周总览</span>
    <span class="section-sub">AI 生成</span>
  </div>
  <div class="card">
    <% report.aiSummary.items.forEach(function(item){ %>
    <div class="summary-item">
      <span class="summary-dot <%= item.status %>"></span>
      <div class="summary-text"><%- boldNums(item.text) %></div>
    </div>
    <% }) %>
  </div>
</div>

<div class="zone zone-decisions">
  <div class="section-header">
    <span class="section-icon">⚡</span>
    <span class="section-title">我的决策清单</span>
    <span class="section-sub"><%= report.decisions.actionRequired.length + report.decisions.needsDecision.length %> 项待处理</span>
  </div>
  <div class="card">
    <% 
      var items = report.decisions.actionRequired.concat(report.decisions.needsDecision).slice(0,3);
      items.sort(function(a,b){ return a.urgency - b.urgency; });
      items.forEach(function(item){ 
    %>
    <div class="decision-item">
      <div class="decision-tag <%= item.level %>"><% if(item.level==='action'){%>🆘<%}else{%>⚡<%}%></div>
      <div class="decision-body">
        <div class="decision-title"><%= item.title %></div>
        <div class="decision-desc"><%- boldNums(item.description) %></div>
        <div class="decision-meta"><span class="decision-source"><%= item.source %></span></div>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<div class="zone zone-overview">
  <div class="section-header">
    <span class="section-icon">📊</span>
    <span class="section-title">本周动态速览</span>
  </div>
  <div class="card">
    <div class="sub-section-title">▎业务体检区</div>
    <div class="health-grid">
      <% report.healthCheck.items.forEach(function(item){ %>
      <div class="health-item">
        <div class="label"><%= item.team %> · <%= item.metric %></div>
        <div class="value"><span class="dot <%= item.status %>"></span> <%- boldNums(item.value) %> · <%= item.detail %></div>
      </div>
      <% }) %>
    </div>
    <div class="sub-section-title" style="margin-top:16px">▎团队动态区</div>
    <div class="event-item">
      <span class="event-icon">📅</span>
      <div class="event-body"><strong>1on1 待覆盖</strong> — <%= report.teamUpdates.oneOnOne.members.join('、') %> 超过 <strong class="hl-num">2</strong> 周未进行一对一。</div>
    </div>
  </div>
</div>

<div class="zone zone-warning">
  <div class="section-header">
    <span class="section-icon">🔭</span>
    <span class="section-title">下周预警</span>
  </div>
  <div class="card">
    <% report.warnings.slice(0,2).forEach(function(w){ %>
    <div class="warn-item">
      <div class="warn-title">
        <% if(w.level==='high'){%><span style="color:#ef4444;">●</span><%}else{%><span style="color:#f59e0b;">●</span><%}%>
        <%= w.title %>
      </div>
      <div class="warn-desc"><%- boldNums(w.description) %></div>
      <div class="warn-prep">⏰ <%= w.deadline %></div>
    </div>
    <% }) %>
  </div>
</div>

<div class="bottom-bar">高管周总结 · 每周一早 8:30 自动推送</div>

</body>
</html>
