<%- include('partials/admin-header', { title, page }) %>
<div class="zone" style="background:#fff;min-height:70vh;">
  <div class="zone-inner">
    <div class="section-header">
      <div class="section-icon">📊</div>
      <span class="section-title">数据管理</span>
      <span class="section-sub">推送统计 · 运行数据</span>
    </div>

    <!-- 推送统计按周 -->
    <div class="card" style="margin-bottom:16px;">
      <div class="sub-section-title">📈 推送统计 — 按周</div>
      <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:14px;">
        <thead>
          <tr style="border-bottom:1px solid #e3e8ee;text-align:left;color:#475569;font-size:12px;font-weight:600;">
            <th style="padding:8px 12px;">周次</th>
            <th style="padding:8px 12px;">推送人数</th>
            <th style="padding:8px 12px;">成功</th>
            <th style="padding:8px 12px;">失败</th>
            <th style="padding:8px 12px;">未推送</th>
            <th style="padding:8px 12px;">接收率</th>
          </tr>
        </thead>
        <tbody>
          <% admin.pushLogs.forEach(function(log){ %>
          <tr style="border-bottom:1px solid #e3e8ee;">
            <td style="padding:10px 12px;font-weight:600;"><%= log.week %></td>
            <td style="padding:10px 12px;"><%= log.total %></td>
            <td style="padding:10px 12px;color:#16a34a;"><%= log.success %></td>
            <td style="padding:10px 12px;color:#dc2626;"><%= log.failed %></td>
            <td style="padding:10px 12px;color:#94a3b8;"><%= log.unpushed %></td>
            <td style="padding:10px 12px;font-weight:600;color:<%= log.rate === '100%' ? '#16a34a' : '#eab308' %>;"><%= log.rate %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </div>

    <!-- 本周推送详情 -->
    <div class="card" style="margin-bottom:16px;">
      <div class="sub-section-title">📋 W20 推送详情</div>
      <% admin.currentWeekDetail.forEach(function(d){ %>
      <div style="display:flex;align-items:center;gap:14px;padding:10px 0;border-bottom:1px solid #e3e8ee;">
        <span style="font-size:11px;padding:3px 10px;background:<%= d.status === 'success' ? '#d1fae5' : d.status === 'failed' ? '#fef2f2' : '#f1f5f9' %>;color:<%= d.status === 'success' ? '#065f46' : d.status === 'failed' ? '#dc2626' : '#64748b' %>;border-radius:9999px;font-weight:600;">
          <%= d.status === 'success' ? '成功' : d.status === 'failed' ? '失败' : '未推送' %>
        </span>
        <div style="flex:1;font-size:13px;"><%= d.name %></div>
        <span style="font-size:12px;color:<%= d.status === 'failed' ? '#dc2626' : '#94a3b8' %>;"><%= d.time %> · <%= d.note %></span>
      </div>
      <% }) %>
    </div>

    <!-- 运行数据 -->
    <div class="card" style="margin-bottom:16px;">
      <div class="sub-section-title">🔧 运行数据 — 近 7 天</div>
      <div class="health-grid">
        <% admin.runStats.forEach(function(s){ %>
        <div class="health-item"><div class="label"><%= s.label %></div><div class="value"><% if(s.status){ %><span class="dot <%= s.status %>"></span> <% } %><%= s.value %></div></div>
        <% }) %>
      </div>
    </div>

    <!-- 操作日志 -->
    <div class="card">
      <div class="sub-section-title">📝 操作日志 — 今日</div>
      <% admin.operationLogs.forEach(function(log){ %>
      <div style="display:flex;align-items:center;gap:14px;padding:10px 0;border-bottom:1px solid #e3e8ee;">
        <span style="font-size:11px;padding:2px 8px;background:<%= log.type === '变更' ? '#eff6ff' : log.type === '编辑' ? '#fefce8' : log.type === '删除' ? '#fef2f2' : '#f1f5f9' %>;color:<%= log.type === '变更' ? '#2563eb' : log.type === '编辑' ? '#a16207' : log.type === '删除' ? '#dc2626' : '#64748b' %>;border-radius:4px;font-weight:600;"><%= log.type %></span>
        <div style="flex:1;font-size:13px;"><%= log.action %></div>
        <span style="font-size:12px;color:#94a3b8;"><%= log.time %> · <%= log.user %></span>
      </div>
      <% }) %>
    </div>
  </div>
</div>
<div class="footer">高管周总结 · 管理后台 · <a href="/" style="color:#533afd;">返回用户主页</a></div>
</body>
</html>
