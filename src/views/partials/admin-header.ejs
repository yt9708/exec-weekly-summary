<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : '管理后台' %> · 高管周总结</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body {
  font-family: 'Inter', 'Noto Sans SC', system-ui, sans-serif;
  background: #ffffff; color: #0a1a2d; font-weight: 400; line-height: 1.65; font-feature-settings: "ss01";
  -webkit-font-smoothing: antialiased;
}
.admin-header { background:#0a1a2d; }
.admin-header-inner { max-width:720px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; padding:12px 24px; }
.admin-logo { font-size:16px; font-weight:600; color:#fff; letter-spacing:0.5px; }
.admin-link { font-size:13px; color:#94a3b8; text-decoration:none; font-weight:400; }
.admin-link:hover { color:#fff; }

.nav-bar { background:#0a1a2d; border-bottom:1px solid #1e293b; }
.nav-inner { max-width:720px; margin:0 auto; padding:10px 24px; display:flex; gap:6px; align-items:center; }
.nav-pill { font-size:13px; font-weight:500; padding:6px 16px; border-radius:9999px; color:#94a3b8; text-decoration:none; transition:all .2s; }
.nav-pill:hover { background:#1e293b; color:#e2e8f0; }
.nav-pill.active { background:#533afd; color:#fff; }
.nav-spacer { flex:1; }

.zone { padding:32px 0; }
.zone-inner { max-width:720px; margin:0 auto; padding:0 24px; }

.section-header { display:flex; align-items:center; gap:10px; margin-bottom:18px; }
.section-icon { width:28px; height:28px; border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; background:#edf2f7; }
.section-title { font-size:19px; font-weight:500; letter-spacing:-0.2px; color:#0a1a2d; }
.section-sub { font-size:13px; color:#475569; margin-left:auto; font-weight:400; }
.card { background:#fff; border-radius:12px; padding:20px 24px; border:1px solid #e3e8ee; box-shadow:rgba(0,55,112,0.04) 0 1px 2px; }
.sub-section-title { font-size:13px; font-weight:600; color:#475569; margin-bottom:12px; letter-spacing:0.1px; }

.decision-item { display:flex; gap:14px; align-items:flex-start; padding:12px 0; }
.decision-item+.decision-item { border-top:1px solid #e3e8ee; }
.decision-tag { width:28px; height:28px; border-radius:7px; display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; }
.decision-tag.action { background:#fef2f2; } .decision-tag.decision { background:#fffbeb; } .decision-tag.info { background:#eff6ff; }
.decision-body { flex:1; min-width:0; }
.decision-title { font-size:15px; font-weight:600; margin-bottom:3px; color:#0a1a2d; }
.decision-desc { font-size:14px; font-weight:400; color:#475569; line-height:1.6; }
.decision-meta { display:flex; gap:8px; align-items:center; margin-top:4px; flex-wrap:wrap; }
.decision-source { font-size:11px; padding:2px 7px; border-radius:9999px; background:#f1f5f9; color:#475569; font-weight:500; }
.decision-link { font-size:12px; color:#533afd; text-decoration:none; font-weight:400; }

.event-item { display:flex; gap:10px; align-items:flex-start; padding:9px 0; }
.event-item+.event-item { border-top:1px solid #e3e8ee; }
.event-icon { font-size:13px; flex-shrink:0; margin-top:2px; }
.event-body { font-size:14px; font-weight:400; color:#475569; line-height:1.6; flex:1; }
.event-body strong { font-weight:600; color:#0a1a2d; }
.warn-item { padding:12px 0; }
.warn-item+.warn-item { border-top:1px solid #e3e8ee; }
.warn-title { font-size:15px; font-weight:600; margin-bottom:3px; }
.warn-desc { font-size:14px; font-weight:400; color:#475569; line-height:1.6; }
.warn-prep { font-size:11px; color:#f59e0b; margin-top:4px; }
.health-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px; }
.health-item { background:#f6f9fc; border-radius:8px; padding:12px 14px; }
.health-item .label { font-size:11px; color:#475569; margin-bottom:3px; }
.health-item .value { font-size:14px; font-weight:600; display:flex; align-items:center; gap:6px; }
.dot { width:7px; height:7px; border-radius:50%; display:inline-block; }
.dot.green { background:#10b981; } .dot.yellow { background:#f59e0b; } .dot.red { background:#ef4444; }
.folded-items { text-align:center; padding:10px; font-size:13px; color:#475569; background:#f8fafc; border-radius:8px; border:1px dashed #dce0e8; margin-top:8px; cursor:pointer; }

.footer { text-align:center; padding:40px 24px; font-size:12px; color:#94a3b8; background:#fff; border-top:1px solid #e3e8ee; }

.action-btn { font-size:14px; font-weight:400; padding:10px 24px; border-radius:9999px; border:none; cursor:pointer; font-family:inherit; transition:all .2s; }
.action-btn-primary { background:#0d253d; color:#fff; }
.action-btn-primary:hover { background:#1a365d; }
.action-btn-accent { background:#533afd; color:#fff; }
.action-btn-accent:hover { background:#4434d4; }
.action-btn:disabled { opacity:0.4; cursor:not-allowed; }

@media (max-width:560px) {
  .zone-inner { padding:0 16px; } .card { padding:18px; }
  .health-grid { grid-template-columns:1fr; }
}
</style>
</head>
<body>

<header class="admin-header">
  <div class="admin-header-inner">
    <span class="admin-logo">高管周总结 · 管理后台</span>
    <a class="admin-link" href="/?mode=admin">概览</a>
  </div>
</header>

<div class="nav-bar">
  <div class="nav-inner">
    <a class="nav-pill" href="/">👤 前台</a>
    <a class="nav-pill <%= page === 'admin' ? 'active' : '' %>" href="/?mode=admin">概览</a>
    <a class="nav-pill <%= page === 'admin-data' ? 'active' : '' %>" href="/?mode=admin&view=data">数据管理</a>
    <span class="nav-spacer"></span>
    <span style="font-size:11px;color:#64748b;padding:4px 10px;border:1px solid #1e293b;border-radius:9999px;">🔧 后台模式</span>
  </div>
</div>
