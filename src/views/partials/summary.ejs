<div class="zone zone-summary">
  <div class="zone-inner">
    <span class="push-badge">✓ 周一 08:30 已推送</span>
    <div class="section-header">
      <div class="section-icon">🧠</div>
      <span class="section-title">本周总览</span>
      <span class="section-sub">AI 生成 · <span id="generateTime"><%= report.weekInfo.pushedAt.slice(0,10) %></span></span>
    </div>
    <div class="card">
      <div id="summaryContainer">
      <% report.aiSummary.items.forEach(function(item){ %>
      <div class="summary-item">
        <span class="summary-dot <%= item.status %>"></span>
        <div class="summary-text"><%- boldNums(item.text) %></div>
      </div>
      <% }) %>
      </div>
      <div class="summary-actions">
        <button class="summary-btn" id="regenerateBtn" onclick="regenerateSummary()">🔄 <span id="btnLabel">重新生成</span></button>
        <button class="summary-btn" onclick="copySummary()">📋 复制摘要</button>
      </div>
      <div id="regenerateError" style="display:none;margin-top:10px;padding:8px 12px;background:#fef2f2;color:#dc2626;border-radius:8px;font-size:12px;font-weight:400;">⚠️ 生成失败，请稍后重试</div>
    </div>
  </div>
</div>
