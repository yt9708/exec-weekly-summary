        <div style="flex:1;">
          <div style="font-size:14px;font-weight:600;">本周周报推送</div>
          <div style="font-size:12px;color:#475569;margin-top:2px;">2026-05-18 08:30 → 10 人已接收</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid #e3e8ee;">
