<%
var channels = (typeof pushChannels !== 'undefined') ? pushChannels : [];
var pushNames = channels.map(function(c){ return c.name; }).join(' · ');
var hasCalendar = channels.some(function(c){ return c.hasCalendar; });
%>
<div class="zone" style="background:#fff;padding-top:0;">
  <div class="zone-inner">
    <div style="border-top:1px solid #e3e8ee;padding-top:24px;text-align:center;">
      <div style="margin-bottom:12px;font-size:13px;color:#64748d;font-weight:300;">
        确认后周报将被锁定，不可再修改
      </div>

      <% if(channels.length > 0){ %>
      <!-- 确认 + 同步日历 -->
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:12px;">
        <button class="action-btn action-btn-primary" id="confirmBtn" onclick="confirmReport()">
          ✓ 确认生成本周总结
        </button>
        <% if(hasCalendar){ %>
        <button class="action-btn action-btn-accent" id="confirmSyncBtn" onclick="confirmAndSync()">
          📅 同步至日历
          <% if(channels.length > 1){ %><span style="font-size:10px;opacity:0.7;">[<%= channels.filter(function(c){return c.hasCalendar;}).map(function(c){return c.name;}).join(' · '); %>]</span><% } %>
        </button>
        <% } %>
      </div>
      <!-- 截图 + 推送 -->
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <button class="action-btn" style="background:#1e293b;color:#fff;" onclick="generateScreenshot(this)">
          🖼️ 生成推送截图
        </button>
        <button class="action-btn" style="background:#0d9488;color:#fff;" onclick="pushToWecom(this)">
          📨 推送周报
          <span style="font-size:10px;opacity:0.7;">[<%= pushNames %>]</span>
        </button>
      </div>
      <% } else { %>
      <div style="padding:20px;color:#94a3b8;font-size:13px;">
        未选择推送渠道 — 请先到 <a href="/datasource" style="color:#533afd;">数据源管理</a> 开启推送渠道
      </div>
      <% } %>

      <div id="confirmResult" style="display:none;margin-top:14px;padding:12px 16px;border-radius:10px;font-size:13px;font-weight:400;"></div>
    </div>
  </div>
</div>
